# Copy to .env; shell startup loads this file.
HOST=127.0.0.1
PORT=8003
LLM_MOCK=1
LLM_MODEL_PATH=models/Qwen3-VL-8B-Instruct
LLM_LORA_PATH=
LLM_DUAL_HEAD_PATH=models/landslide_qwen3vl_dual_head_continuous_10ep_best
OPENTOPOGRAPHY_API_KEY=
# Set absolute paths for real model inference:
# LLM_ENV_PYTHON=/path/to/python
# SEG_ENV_PYTHON=/path/to/segmentation/python
# CLS_ENV_PYTHON=/path/to/classification/python
# MMSEG_CONFIG_PATH=/path/to/config.py
# MMSEG_CHECKPOINT_PATH=/path/to/checkpoint.pth
# CLS_CONFIG_PATH=/path/to/config.py
# CLS_CHECKPOINT_PATH=/path/to/checkpoint.pth

# Generation request adapters; weights must be supplied separately.
LLM_VISUAL_EVIDENCE_ADAPTER=base
LLM_FIRST_PASS_ADAPTER=dualhead
LLM_DESCRIBE_ADAPTER=dualhead
